<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.sea.simplecalculator.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox alignment="CENTER" prefHeight="4.0" prefWidth="200.0">
      <children>
         <TextField fx:id="textNumber1" prefHeight="24.0" prefWidth="85.0" promptText="1" />
      
          <Label fx:id="labelOperator" alignment="CENTER" prefHeight="16.0" prefWidth="32.0" text=":|" />
         <TextField fx:id="textNumber2" prefHeight="24.0" prefWidth="85.0" promptText="1" />
      </children>
   </HBox>
   <HBox alignment="CENTER" prefHeight="0.0" prefWidth="200.0">
      <children>
         <Button fx:id="buttonPlus" mnemonicParsing="false" onAction="#onButtonChangeOperator" prefHeight="24.0" prefWidth="31.0" text=":)">
            <HBox.margin>
               <Insets left="5.0" right="5.0" />
            </HBox.margin>
            <padding>
               <Insets bottom="4.0" />
            </padding>
         </Button>
         <Button fx:id="buttonMinus" mnemonicParsing="false" onAction="#onButtonChangeOperator" prefHeight="24.0" prefWidth="31.0" text=":(">
            <HBox.margin>
               <Insets left="5.0" right="5.0" />
            </HBox.margin>
            <padding>
               <Insets bottom="3.0" />
            </padding>
         </Button>
         <Button fx:id="buttonMultiply" mnemonicParsing="false" onAction="#onButtonChangeOperator" prefHeight="24.0" prefWidth="31.0" text=":D">
            <HBox.margin>
               <Insets left="5.0" right="5.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="buttonDivide" mnemonicParsing="false" onAction="#onButtonChangeOperator" prefHeight="24.0" prefWidth="31.0" text="D:">
            <HBox.margin>
               <Insets left="5.0" right="5.0" />
            </HBox.margin>
         </Button>
      </children>
   </HBox>
    <Button fx:id="buttonCalculate" onAction="#onButtonCalculateClick" text="Calculate" />
   <HBox prefHeight="0.0" prefWidth="200.0">
      <children>
         <Label prefHeight="16.0" prefWidth="51.0" text="Result:" />
         <Label fx:id="labelResult" text="idk.. yet..." />
      </children>
   </HBox>
   <effect>
      <DropShadow />
   </effect>
</VBox>
